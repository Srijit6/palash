database -open waves -into waves.shm -default
probe -create -shm tb_intel_4004.uut.control_inst.current_state tb_intel_4004.uut.control_inst.cycle_state
run
probe -create -shm tb_intel_4004.uut.control_inst.next_state
run
stop -create -object tb_intel_4004.uut.control_inst.next_state -name tb_intel_4004.uut.control_inst.next_state
stop -create -object tb_intel_4004.uut.control_inst.current_state -name tb_intel_4004.uut.control_inst.current_state
exit
