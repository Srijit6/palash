# Version:1.0 MMMC View Definition File
# Do Not Remove Above Line
create_library_set -name fast -timing {../../../install/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_library_set -name slow -timing {../../../install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_constraint_mode -name exp_sdc -sdc_files {outputs/exp_constraints.sdc}
create_delay_corner -name fast_dc -library_set {fast}
create_delay_corner -name slow_dc -library_set {slow}
create_analysis_view -name best_case -constraint_mode {exp_sdc} -delay_corner {fast_dc}
create_analysis_view -name worst_case -constraint_mode {exp_sdc} -delay_corner {slow_dc}
set_analysis_view -setup {worst_case} -hold {best_case}
