library (teaching_lib) {
  technology : cmos;
  delay_model : table_lookup;

  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1uW";
  capacitive_load_unit (1,pf);

  nom_process : 1.0;
  nom_temperature : 25;
  nom_voltage : 1.0;

  default_operating_conditions : TYP;
  default_input_pin_cap : 0.01;
  default_output_pin_cap : 0.01;
  default_max_transition : 1.0;
  default_max_capacitance : 2.0;
  default_fanout_load : 1.0;

  operating_conditions (TYP) {
    process : 1.0;
    temperature : 25;
    voltage : 1.0;
    tree_type : balanced_tree;
  }

  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.10");
    index_2 ("0.01, 0.10");
  }

  lu_table_template (constraint_template) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.01, 0.10");
    index_2 ("0.01, 0.10");
  }

  cell (INV_X1) {
    area : 1.0;
    cell_leakage_power : 0.20;
    dont_use : false;
    dont_touch : false;
    pin(A) {
      direction : input;
      capacitance : 0.01;
    }
    pin(Y) {
      direction : output;
      function : "!A";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise(delay_template) {
          values("0.04,0.06", "0.05,0.07");
        }
        cell_fall(delay_template) {
          values("0.04,0.06", "0.05,0.07");
        }
        rise_transition(delay_template) {
          values("0.03,0.04", "0.04,0.05");
        }
        fall_transition(delay_template) {
          values("0.03,0.04", "0.04,0.05");
        }
      }
    }
  }

  cell (BUF_X1) {
    area : 1.0;
    cell_leakage_power : 0.20;
    dont_use : false;
    dont_touch : false;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "A";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : positive_unate;
        cell_rise(delay_template) { values("0.04,0.06", "0.05,0.07"); }
        cell_fall(delay_template) { values("0.04,0.06", "0.05,0.07"); }
        rise_transition(delay_template) { values("0.03,0.04", "0.04,0.05"); }
        fall_transition(delay_template) { values("0.03,0.04", "0.04,0.05"); }
      }
    }
  }

  cell (AND2_X1) {
    area : 1.4;
    cell_leakage_power : 0.30;
    dont_use : false;
    dont_touch : false;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(B) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "A & B";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : positive_unate;
        cell_rise(delay_template){ values("0.06,0.08","0.07,0.10"); }
        cell_fall(delay_template){ values("0.06,0.08","0.07,0.10"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
      timing() {
        related_pin : "B";
        timing_type : combinational;
        timing_sense : positive_unate;
        cell_rise(delay_template){ values("0.06,0.08","0.07,0.10"); }
        cell_fall(delay_template){ values("0.06,0.08","0.07,0.10"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
    }
  }

  cell (NAND2_X1) {
    area : 1.3;
    cell_leakage_power : 0.28;
    dont_use : false;
    dont_touch : false;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(B) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "!(A & B)";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise(delay_template){ values("0.055,0.075","0.065,0.09"); }
        cell_fall(delay_template){ values("0.055,0.075","0.065,0.09"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
      timing() {
        related_pin : "B";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise(delay_template){ values("0.055,0.075","0.065,0.09"); }
        cell_fall(delay_template){ values("0.055,0.075","0.065,0.09"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
    }
  }

  cell (OR2_X1) {
    area : 1.4;
    cell_leakage_power : 0.30;
    dont_use : false;
    dont_touch : false;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(B) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "A | B";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : positive_unate;
        cell_rise(delay_template){ values("0.06,0.08","0.07,0.10"); }
        cell_fall(delay_template){ values("0.06,0.08","0.07,0.10"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
      timing() {
        related_pin : "B";
        timing_type : combinational;
        timing_sense : positive_unate;
        cell_rise(delay_template){ values("0.06,0.08","0.07,0.10"); }
        cell_fall(delay_template){ values("0.06,0.08","0.07,0.10"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
    }
  }

  cell (NOR2_X1) {
    area : 1.3;
    cell_leakage_power : 0.28;
    dont_use : false;
    dont_touch : false;
    pin(A) { direction : input; capacitance : 0.01; }
    pin(B) { direction : input; capacitance : 0.01; }
    pin(Y) {
      direction : output;
      function : "!(A | B)";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise(delay_template){ values("0.055,0.075","0.065,0.09"); }
        cell_fall(delay_template){ values("0.055,0.075","0.065,0.09"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
      timing() {
        related_pin : "B";
        timing_type : combinational;
        timing_sense : negative_unate;
        cell_rise(delay_template){ values("0.055,0.075","0.065,0.09"); }
        cell_fall(delay_template){ values("0.055,0.075","0.065,0.09"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
    }
  }

  cell (XOR2_X1) {
    area : 2.0;
    cell_leakage_power : 0.50;
    dont_use : false;
    dont_touch : false;
    pin(A) { direction : input; capacitance : 0.015; }
    pin(B) { direction : input; capacitance : 0.015; }
    pin(Y) {
      direction : output;
      function : "A ^ B";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : non_unate;
        cell_rise(delay_template){ values("0.09,0.12","0.10,0.14"); }
        cell_fall(delay_template){ values("0.09,0.12","0.10,0.14"); }
        rise_transition(delay_template){ values("0.06,0.08","0.07,0.09"); }
        fall_transition(delay_template){ values("0.06,0.08","0.07,0.09"); }
      }
      timing() {
        related_pin : "B";
        timing_type : combinational;
        timing_sense : non_unate;
        cell_rise(delay_template){ values("0.09,0.12","0.10,0.14"); }
        cell_fall(delay_template){ values("0.09,0.12","0.10,0.14"); }
        rise_transition(delay_template){ values("0.06,0.08","0.07,0.09"); }
        fall_transition(delay_template){ values("0.06,0.08","0.07,0.09"); }
      }
    }
  }

  cell (MUX2_X1) {
    area : 2.2;
    cell_leakage_power : 0.55;
    dont_use : false;
    dont_touch : false;
    pin(A) { direction : input; capacitance : 0.015; }
    pin(B) { direction : input; capacitance : 0.015; }
    pin(S) { direction : input; capacitance : 0.015; }
    pin(Y) {
      direction : output;
      function : "(!S & A) | (S & B)";
      max_capacitance : 2.0;
      timing() {
        related_pin : "A";
        timing_type : combinational;
        timing_sense : non_unate;
        cell_rise(delay_template){ values("0.10,0.13","0.12,0.16"); }
        cell_fall(delay_template){ values("0.10,0.13","0.12,0.16"); }
        rise_transition(delay_template){ values("0.07,0.09","0.08,0.10"); }
        fall_transition(delay_template){ values("0.07,0.09","0.08,0.10"); }
      }
      timing() {
        related_pin : "B";
        timing_type : combinational;
        timing_sense : non_unate;
        cell_rise(delay_template){ values("0.10,0.13","0.12,0.16"); }
        cell_fall(delay_template){ values("0.10,0.13","0.12,0.16"); }
        rise_transition(delay_template){ values("0.07,0.09","0.08,0.10"); }
        fall_transition(delay_template){ values("0.07,0.09","0.08,0.10"); }
      }
      timing() {
        related_pin : "S";
        timing_type : combinational;
        timing_sense : non_unate;
        cell_rise(delay_template){ values("0.11,0.14","0.13,0.17"); }
        cell_fall(delay_template){ values("0.11,0.14","0.13,0.17"); }
        rise_transition(delay_template){ values("0.07,0.09","0.08,0.10"); }
        fall_transition(delay_template){ values("0.07,0.09","0.08,0.10"); }
      }
    }
  }

  cell (DFF_X1) {
    area : 4.0;
    cell_leakage_power : 0.80;
    dont_use : false;
    dont_touch : false;

    ff (IQ, IQN) {
      clocked_on : "CLK";
      next_state : "D";
    }

    pin(CLK) {
      direction : input;
      clock : true;
      capacitance : 0.03;
    }

    pin(D) {
      direction : input;
      capacitance : 0.015;
      timing() {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
        fall_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
      }
      timing() {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
        fall_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
      }
    }

    pin(Q) {
      direction : output;
      function : "IQ";
      max_capacitance : 2.0;
      timing() {
        related_pin : "CLK";
        timing_type : rising_edge;
        timing_sense : non_unate;
        cell_rise(delay_template){ values("0.08,0.10","0.09,0.12"); }
        cell_fall(delay_template){ values("0.08,0.10","0.09,0.12"); }
        rise_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
        fall_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
      }
    }
  }


cell (DFF4_X1) {
  area : 13.0;
  cell_leakage_power : 2.50;
  dont_use : false;
  dont_touch : false;

  ff (IQ0, IQN0) { clocked_on : "CLK"; next_state : "D0"; }
  ff (IQ1, IQN1) { clocked_on : "CLK"; next_state : "D1"; }
  ff (IQ2, IQN2) { clocked_on : "CLK"; next_state : "D2"; }
  ff (IQ3, IQN3) { clocked_on : "CLK"; next_state : "D3"; }

  pin(CLK) {
    direction : input;
    clock : true;
    capacitance : 0.075;
  }

  pin(D0) {
    direction : input;
    capacitance : 0.015;
    timing() {
      related_pin : "CLK";
      timing_type : setup_rising;
      rise_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
      fall_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
    }
    timing() {
      related_pin : "CLK";
      timing_type : hold_rising;
      rise_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
      fall_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
    }
  }
  pin(D1) {
    direction : input;
    capacitance : 0.015;
    timing() {
      related_pin : "CLK";
      timing_type : setup_rising;
      rise_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
      fall_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
    }
    timing() {
      related_pin : "CLK";
      timing_type : hold_rising;
      rise_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
      fall_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
    }
  }
  pin(D2) {
    direction : input;
    capacitance : 0.015;
    timing() {
      related_pin : "CLK";
      timing_type : setup_rising;
      rise_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
      fall_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
    }
    timing() {
      related_pin : "CLK";
      timing_type : hold_rising;
      rise_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
      fall_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
    }
  }
  pin(D3) {
    direction : input;
    capacitance : 0.015;
    timing() {
      related_pin : "CLK";
      timing_type : setup_rising;
      rise_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
      fall_constraint(constraint_template){ values("0.05,0.05","0.05,0.05"); }
    }
    timing() {
      related_pin : "CLK";
      timing_type : hold_rising;
      rise_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
      fall_constraint(constraint_template){ values("0.02,0.02","0.02,0.02"); }
    }
  }

  pin(Q0) {
    direction : output;
    function : "IQ0";
    max_capacitance : 2.0;
    timing() {
      related_pin : "CLK";
      timing_type : rising_edge;
      timing_sense : non_unate;
      cell_rise(delay_template){ values("0.09,0.11","0.10,0.13"); }
      cell_fall(delay_template){ values("0.09,0.11","0.10,0.13"); }
      rise_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
      fall_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
    }
  }
  pin(Q1) {
    direction : output;
    function : "IQ1";
    max_capacitance : 2.0;
    timing() {
      related_pin : "CLK";
      timing_type : rising_edge;
      timing_sense : non_unate;
      cell_rise(delay_template){ values("0.09,0.11","0.10,0.13"); }
      cell_fall(delay_template){ values("0.09,0.11","0.10,0.13"); }
      rise_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
      fall_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
    }
  }
  pin(Q2) {
    direction : output;
    function : "IQ2";
    max_capacitance : 2.0;
    timing() {
      related_pin : "CLK";
      timing_type : rising_edge;
      timing_sense : non_unate;
      cell_rise(delay_template){ values("0.09,0.11","0.10,0.13"); }
      cell_fall(delay_template){ values("0.09,0.11","0.10,0.13"); }
      rise_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
      fall_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
    }
  }
  pin(Q3) {
    direction : output;
    function : "IQ3";
    max_capacitance : 2.0;
    timing() {
      related_pin : "CLK";
      timing_type : rising_edge;
      timing_sense : non_unate;
      cell_rise(delay_template){ values("0.09,0.11","0.10,0.13"); }
      cell_fall(delay_template){ values("0.09,0.11","0.10,0.13"); }
      rise_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
      fall_transition(delay_template){ values("0.05,0.06","0.06,0.07"); }
    }
  }
}

cell (RETDFF_X1) {
  area : 6.0;
  cell_leakage_power : 0.95;
  dont_use : false;
  dont_touch : false;

  ff (IQ, IQN) {
    clocked_on : "CLK";
    next_state : "D";
  }

  pin(CLK) { direction : input; clock : true; capacitance : 0.035; }
  pin(D) {
    direction : input;
    capacitance : 0.015;
    timing() {
      related_pin : "CLK";
      timing_type : setup_rising;
      rise_constraint(constraint_template){ values("0.06,0.06","0.06,0.06"); }
      fall_constraint(constraint_template){ values("0.06,0.06","0.06,0.06"); }
    }
  }
  pin(Q) {
    direction : output;
    function : "IQ";
    max_capacitance : 2.0;
    timing() {
      related_pin : "CLK";
      timing_type : rising_edge;
      timing_sense : non_unate;
      cell_rise(delay_template){ values("0.10,0.12","0.11,0.14"); }
      cell_fall(delay_template){ values("0.10,0.12","0.11,0.14"); }
      rise_transition(delay_template){ values("0.06,0.07","0.07,0.08"); }
      fall_transition(delay_template){ values("0.06,0.07","0.07,0.08"); }
    }
  }
  pin(SAVE){ direction : input; capacitance : 0.01; }
  pin(RESTORE){ direction : input; capacitance : 0.01; }
}

  /* Structural teaching cells. These are not production power-intent models. */

  cell (ICG_X1) {
    area : 2.5;
    cell_leakage_power : 0.45;
    dont_use : false;
    dont_touch : false;
    clock_gating_integrated_cell : true;

    latch (IQ, IQN) {
      data_in : "EN";
      enable : "!CLK";
    }

    pin(CLK) {
      direction : input;
      clock : true;
      capacitance : 0.02;
      clock_gate_clock_pin : true;
    }
    pin(EN) {
      direction : input;
      capacitance : 0.01;
      clock_gate_enable_pin : true;
    }
    pin(GCLK) {
      direction : output;
      function : "CLK & IQ";
      clock_gate_out_pin : true;
      max_capacitance : 2.0;
      timing() {
        related_pin : "CLK";
        timing_type : combinational;
        timing_sense : positive_unate;
        cell_rise(delay_template){ values("0.05,0.07","0.06,0.08"); }
        cell_fall(delay_template){ values("0.05,0.07","0.06,0.08"); }
        rise_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
        fall_transition(delay_template){ values("0.04,0.05","0.05,0.06"); }
      }
    }
  }

  cell (ISO0_X1) {
    area : 1.8;
    cell_leakage_power : 0.25;
    dont_use : false;
    dont_touch : false;
    pin(A){ direction:input; capacitance:0.01; }
    pin(ISO_N){ direction:input; capacitance:0.01; }
    pin(Y){
      direction:output;
      function:"A & ISO_N";
      max_capacitance:2.0;
      timing(){
        related_pin:"A";
        timing_type:combinational;
        timing_sense:positive_unate;
        cell_rise(delay_template){values("0.07,0.09","0.08,0.11");}
        cell_fall(delay_template){values("0.07,0.09","0.08,0.11");}
        rise_transition(delay_template){values("0.05,0.06","0.06,0.07");}
        fall_transition(delay_template){values("0.05,0.06","0.06,0.07");}
      }
    }
  }

  cell (LS_X1) {
    area : 2.4;
    cell_leakage_power : 0.30;
    dont_use : false;
    dont_touch : false;
    pin(A){direction:input;capacitance:0.012;}
    pin(Y){
      direction:output;
      function:"A";
      max_capacitance:2.0;
      timing(){
        related_pin:"A";
        timing_type:combinational;
        timing_sense:positive_unate;
        cell_rise(delay_template){values("0.09,0.12","0.10,0.14");}
        cell_fall(delay_template){values("0.09,0.12","0.10,0.14");}
        rise_transition(delay_template){values("0.06,0.08","0.07,0.09");}
        fall_transition(delay_template){values("0.06,0.08","0.07,0.09");}
      }
    }
  }

  cell (POWER_SWITCH_X1) {
    area : 5.0;
    cell_leakage_power : 0.35;
    dont_use : false;
    dont_touch : false;
    pin(SLEEP){direction:input;capacitance:0.01;}
    pin(PWR_OK){
      direction:output;
      function:"!SLEEP";
      max_capacitance:2.0;
      timing(){
        related_pin:"SLEEP";
        timing_type:combinational;
        timing_sense:negative_unate;
        cell_rise(delay_template){values("0.05,0.06","0.06,0.07");}
        cell_fall(delay_template){values("0.05,0.06","0.06,0.07");}
        rise_transition(delay_template){values("0.04,0.05","0.05,0.06");}
        fall_transition(delay_template){values("0.04,0.05","0.05,0.06");}
      }
    }
  }
}
