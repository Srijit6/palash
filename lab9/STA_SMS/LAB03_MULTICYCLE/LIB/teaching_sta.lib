/* ==================================================================
   teaching_sta.lib  -  simple teaching library for Tempus STA labs
   All delays are constant (independent of slew/load) so that every
   slack in the labs can be calculated by hand.

     INV_X1     : 0.40 ns          BUF_X1  : 0.50 ns
     DLY_X1     : 1.00 ns          ICG_X1  : CLK->GCLK 0.10 ns
     DFFPOS_X1  : CLK->Q 0.20 ns, setup 0.20 ns, hold 0.10 ns (rising)
     DFFNEG_X1  : CLK->Q 0.20 ns, setup 0.20 ns, hold 0.10 ns (falling)
     ICG_X1     : EN setup 0.50 ns, EN hold 0.20 ns (rising CLK)
   ================================================================== */

library (teaching_sta_lib) {
  technology (cmos);
  delay_model : table_lookup;

  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  capacitive_load_unit (1,pf);
  leakage_power_unit : "1nW";
  pulling_resistance_unit : "1kohm";

  nom_process : 1;
  nom_temperature : 25;
  nom_voltage : 1.0;

  operating_conditions (typical) {
    process : 1;
    temperature : 25;
    voltage : 1.0;
  }
  default_operating_conditions : typical;

  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  slew_lower_threshold_pct_rise : 20;
  slew_upper_threshold_pct_rise : 80;
  slew_lower_threshold_pct_fall : 20;
  slew_upper_threshold_pct_fall : 80;
  slew_derate_from_library : 1.0;

  default_input_pin_cap : 0.002;
  default_output_pin_cap : 0.0;
  default_inout_pin_cap : 0.002;
  default_fanout_load : 1.0;
  default_max_transition : 1.0;
  default_cell_leakage_power : 0.0;
  default_leakage_power_density : 0.0;

  lu_table_template (delay_template) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.01, 0.10");
    index_2 ("0.001, 0.010");
  }

  lu_table_template (constraint_template) {
    variable_1 : constrained_pin_transition;
    variable_2 : related_pin_transition;
    index_1 ("0.01, 0.10");
    index_2 ("0.01, 0.10");
  }

  /* ---------------------------------------------------------------- */
  cell (INV_X1) {
    area : 1.0;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "!A";
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise (delay_template) { values ("0.40,0.40","0.40,0.40"); }
        cell_fall (delay_template) { values ("0.40,0.40","0.40,0.40"); }
        rise_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
        fall_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
      }
    }
  }

  /* ---------------------------------------------------------------- */
  cell (BUF_X1) {
    area : 1.0;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (delay_template) { values ("0.50,0.50","0.50,0.50"); }
        cell_fall (delay_template) { values ("0.50,0.50","0.50,0.50"); }
        rise_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
        fall_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
      }
    }
  }

  /* ---------------------------------------------------------------- */
  cell (DLY_X1) {
    area : 1.0;
    pin (A) { direction : input; capacitance : 0.002; }
    pin (Y) {
      direction : output;
      function : "A";
      timing () {
        related_pin : "A";
        timing_sense : positive_unate;
        cell_rise (delay_template) { values ("1.00,1.00","1.00,1.00"); }
        cell_fall (delay_template) { values ("1.00,1.00","1.00,1.00"); }
        rise_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
        fall_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
      }
    }
  }

  /* ---------------------------------------------------------------- */
  cell (DFFPOS_X1) {
    area : 4.0;
    ff (IQ,IQN) { clocked_on : "CLK"; next_state : "D"; }
    pin (CLK) { direction : input; clock : true; capacitance : 0.002; }
    pin (D) {
      direction : input;
      capacitance : 0.002;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint (constraint_template) { values ("0.20,0.20","0.20,0.20"); }
        fall_constraint (constraint_template) { values ("0.20,0.20","0.20,0.20"); }
      }
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint (constraint_template) { values ("0.10,0.10","0.10,0.10"); }
        fall_constraint (constraint_template) { values ("0.10,0.10","0.10,0.10"); }
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () {
        related_pin : "CLK";
        timing_type : rising_edge;
        cell_rise (delay_template) { values ("0.20,0.20","0.20,0.20"); }
        cell_fall (delay_template) { values ("0.20,0.20","0.20,0.20"); }
        rise_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
        fall_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
      }
    }
  }

  /* ---------------------------------------------------------------- */
  cell (DFFNEG_X1) {
    area : 4.0;
    ff (IQ,IQN) { clocked_on : "!CLK"; next_state : "D"; }
    pin (CLK) { direction : input; clock : true; capacitance : 0.002; }
    pin (D) {
      direction : input;
      capacitance : 0.002;
      timing () {
        related_pin : "CLK";
        timing_type : setup_falling;
        rise_constraint (constraint_template) { values ("0.20,0.20","0.20,0.20"); }
        fall_constraint (constraint_template) { values ("0.20,0.20","0.20,0.20"); }
      }
      timing () {
        related_pin : "CLK";
        timing_type : hold_falling;
        rise_constraint (constraint_template) { values ("0.10,0.10","0.10,0.10"); }
        fall_constraint (constraint_template) { values ("0.10,0.10","0.10,0.10"); }
      }
    }
    pin (Q) {
      direction : output;
      function : "IQ";
      timing () {
        related_pin : "CLK";
        timing_type : falling_edge;
        cell_rise (delay_template) { values ("0.20,0.20","0.20,0.20"); }
        cell_fall (delay_template) { values ("0.20,0.20","0.20,0.20"); }
        rise_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
        fall_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
      }
    }
  }

  /* ----------------------------------------------------------------
     Integrated clock-gating cell (latch-based, positive edge).
     Standard Liberty ICG modelling:
       - statetable + internal pin IQ  (latch transparent while CLK=0)
       - clock_gate_clock_pin / clock_gate_enable_pin / clock_gate_out_pin
       - EN setup/hold use the normal setup_rising / hold_rising types
     ---------------------------------------------------------------- */
  cell (ICG_X1) {
    area : 3.0;
    clock_gating_integrated_cell : "latch_posedge";

    statetable ("CLK EN", "IQ") {
      table : "L L : - : L, \
               L H : - : H, \
               H - : - : N";
    }

    pin (IQ) {
      direction : internal;
      internal_node : "IQ";
    }

    pin (CLK) {
      direction : input;
      capacitance : 0.002;
      clock : true;
      clock_gate_clock_pin : true;
    }

    pin (EN) {
      direction : input;
      capacitance : 0.002;
      clock_gate_enable_pin : true;
      timing () {
        related_pin : "CLK";
        timing_type : setup_rising;
        rise_constraint (constraint_template) { values ("0.50,0.50","0.50,0.50"); }
        fall_constraint (constraint_template) { values ("0.50,0.50","0.50,0.50"); }
      }
      timing () {
        related_pin : "CLK";
        timing_type : hold_rising;
        rise_constraint (constraint_template) { values ("0.20,0.20","0.20,0.20"); }
        fall_constraint (constraint_template) { values ("0.20,0.20","0.20,0.20"); }
      }
    }

    pin (GCLK) {
      direction : output;
      clock_gate_out_pin : true;
      state_function : "CLK & IQ";
      timing () {
        related_pin : "CLK";
        timing_sense : positive_unate;
        cell_rise (delay_template) { values ("0.10,0.10","0.10,0.10"); }
        cell_fall (delay_template) { values ("0.10,0.10","0.10,0.10"); }
        rise_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
        fall_transition (delay_template) { values ("0.05,0.05","0.05,0.05"); }
      }
    }
  }
}
