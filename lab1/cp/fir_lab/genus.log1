@file(syn_all.tcl) 40: set DESIGNS {
    {fir                 fir_4tap              fir_4tap.v              fir_4tap.sdc}
    {fir_piplined        fir_4tap_pipelined    fir_4tap_pipelined.v    fir_4tap_pipelined.sdc}
