# Version:1.0 MMMC View Definition File
create_library_set -name max_time -timing {/home/install/FOUNDRY/digital/90nm/dig/lib/slow.lib}
create_library_set -name min_time -timing {/home/install/FOUNDRY/digital/90nm/dig/lib/fast.lib}
create_constraint_mode -name fir_constraints -sdc_files {fir_4tap_shared_mult_synth.sdc}
create_delay_corner -name max_delay -library_set {max_time}
create_delay_corner -name min_delay -library_set {min_time}
create_analysis_view -name setup_new -constraint_mode {fir_constraints} -delay_corner {max_delay}
create_analysis_view -name hold_view -constraint_mode {fir_constraints} -delay_corner {min_delay}
set_analysis_view -setup {setup_new} -hold {hold_view}
